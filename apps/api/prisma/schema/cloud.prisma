enum CloudProvider {
  AWS
  AZURE
}

model CloudAccount {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  provider          CloudProvider
  externalAccountId String        @map("external_account_id")
  isActive          Boolean       @default(true) @map("is_active")

  awsCredentialsSecretArn String? @map("aws_credentials_secret_arn")
  awsSecretsRegion        String? @map("aws_secrets_region")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usage    CloudUsageMonthly[]
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([provider, externalAccountId])
  @@index([customerId, isActive])
  @@map("cloud_accounts")
}

model CloudUsageMonthly {
  id             String   @id @default(uuid()) @db.Uuid
  cloudAccountId String   @map("cloud_account_id") @db.Uuid
  billingMonth   DateTime @map("billing_month") @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("AED") @db.VarChar(3)
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Restrict)

  @@unique([cloudAccountId, billingMonth])
  @@index([billingMonth])
  @@map("cloud_usage_monthly")
}
