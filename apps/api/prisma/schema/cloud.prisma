enum CloudProvider {
  AWS
  AZURE
}

model CloudAccount {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String              @map("customer_id") @db.Uuid
  provider          CloudProvider
  externalAccountId String              @map("external_account_id")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  usage             CloudUsageMonthly[]

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([provider, externalAccountId])
  @@index([customerId])
  @@index([customerId, isActive])
  @@map("cloud_accounts")
}

model CloudUsageMonthly {
  id             String   @id @default(uuid()) @db.Uuid
  cloudAccountId String   @map("cloud_account_id") @db.Uuid
  billingMonth   DateTime @map("billing_month") @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("AED") @db.VarChar(3)
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id])

  @@unique([cloudAccountId, billingMonth])
  @@index([billingMonth])
  @@index([cloudAccountId, billingMonth])
  @@map("cloud_usage_monthly")
}
