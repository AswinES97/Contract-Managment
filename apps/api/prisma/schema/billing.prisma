enum InvoiceState {
  PENDING
  RAISED
  COMPLETED
}

enum BillLineSourceType {
  FIXED_SERVICE
  CLOUD_USAGE
}

model Bill {
  id                  String   @id @default(uuid()) @db.Uuid
  contractId          String   @map("contract_id") @db.Uuid
  periodStart         DateTime @map("period_start") @db.Date
  periodEnd           DateTime @map("period_end") @db.Date
  billingMonth        String   @map("billing_month")
  currency            String   @default("AED") @db.VarChar(3)
  fixedAmount         Int      @default(0) @map("fixed_amount")
  cloudUsageAmount    Int      @default(0) @map("cloud_usage_amount")
  cloudDiscountAmount Int      @default(0) @map("cloud_discount_amount")
  totalAmount         Int      @map("total_amount")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  lineItems     BillLineItem[]
  invoiceStatus InvoiceStatus?
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, periodStart, periodEnd])
  @@index([contractId])
  @@index([periodStart, periodEnd])
  @@map("bills")
}

model BillLineItem {
  id                 String             @id @default(uuid()) @db.Uuid
  billId             String             @map("bill_id") @db.Uuid
  description        String
  sourceType         BillLineSourceType @map("source_type")
  quantity           Int                @default(1)
  unitAmount         Int                @map("unit_amount")
  discountPercentage Int                @default(0) @map("discount_percentage")
  finalAmount        Int                @map("final_amount")
  createdAt          DateTime           @default(now()) @map("created_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_line_items")
}

model InvoiceStatus {
  id            String       @id @default(uuid()) @db.Uuid
  billId        String       @unique @map("bill_id") @db.Uuid
  status        InvoiceState @default(PENDING)
  invoiceNumber String?      @map("invoice_number")
  invoiceDate   DateTime?    @map("invoice_date") @db.Date
  checkedAt     DateTime     @default(now()) @map("checked_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([checkedAt])
  @@map("invoice_status")
}
