enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id               String         @id @default(uuid()) @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  scopeDescription String?        @map("scope_description")
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  status           ContractStatus @default(DRAFT)

  billingFrequency String? @map("billing_frequency")
  billingTiming    String? @map("billing_timing")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  services        ContractService[]
  onboardingSteps OnboardingStep[]
  bills           Bill[]

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([customerId, status])
  @@map("contracts")
}

model ContractService {
  id            String @id @default(uuid()) @db.Uuid
  contractId    String @map("contract_id") @db.Uuid
  serviceTypeId String @map("service_type_id") @db.Uuid

  monthlyAmount Int? @map("monthly_amount")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceType ServiceType       @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  discounts   ServiceDiscount[]

  @@index([contractId])
  @@index([serviceTypeId])
  @@index([contractId, startDate, endDate])
  @@map("contract_services")
}

model ServiceDiscount {
  id                String @id @default(uuid()) @db.Uuid
  contractServiceId String @map("contract_service_id") @db.Uuid
  percentage        Int

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  contractService ContractService @relation(fields: [contractServiceId], references: [id], onDelete: Cascade)

  @@index([contractServiceId])
  @@index([contractServiceId, effectiveFrom, effectiveTo])
  @@map("service_discounts")
}
