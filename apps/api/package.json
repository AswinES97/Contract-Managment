{
  "name": "contract-managment",
  "version": "1.0.0",
  "description": "Contract Management API",
  "type": "module",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "compiler": "tsc --watch",
    "server": "nodemon --inspect dist/app.js",
    "start": "node dist/app.js",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:generate": "npx prisma format && npx prisma generate --config=prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config=prisma7.config.ts",
    "db:migrate:prod": "prisma migrate deploy --config=prisma7.config.ts",
    "db:status": "prisma migrate status --config=prisma7.config.ts",
    "db:studio": "prisma studio --config=prisma7.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  }
}
